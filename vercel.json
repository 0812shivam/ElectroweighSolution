{
    "version": 2,
    "builds": [
      {
        "src": "api/**/*.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/send-email",
        "dest": "/api/send-email.js"
      },
      {
        "src": "/apply-now",
        "dest": "/api/apply-now.js"
      },
      {
        "src": "/(.*)",
        "dest": "/public/$1"
      }
    ]
  }
  